# SQLite database file (created on first run)
DB_PATH=./data/architect.db
# Question bank loaded into the database when it is empty, or by `npm run db:seed`
QUESTIONS_PATH=./data/questions.json

# Coaching chat assistant (Claude Messages API). The key stays on the server and is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: override the API endpoint (leave empty for the default)
ANTHROPIC_BASE_URL=
